# Secrets — never commit. The scanner's .env holds live Telegram and Google
# Sheets credentials; the web app's .env.local holds API keys.
.env
.env.*
!.env.example
!.env.local.template
!.dev.vars.template

# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/
dist/
coverage/
*.tsbuildinfo

# Runtime state, not source. CI force-adds the offset so it persists
# between scheduled runs; locally it should stay out of commits.
apps/scanner/data/.telegram-offset

# macOS
.DS_Store

# Certs
*.pem

# /resume skill scratch — draft resumes generated by `build`, diffed by
# `learn` against what was actually shipped. Not source, safe to delete.
packages/profile/drafts/

# Personal data — never commit. Start from the *.example files instead.
packages/profile/master-profile.json
packages/profile/cv.md
packages/profile/voice-dna.md
packages/profile/resume-preferences.md
application-answers*.md
*_MASTER_Resume*.pdf
apps/extension/extension-profile.json

# Third-party reference PDFs (copyrighted). Keep locally, never commit.
apps/web/knowledge-base/raw/
