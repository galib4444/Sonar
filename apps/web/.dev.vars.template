# Cloudflare Workers/Pages Local Development Environment Variables
# Copy this file to .dev.vars and fill in your actual values
# .dev.vars is gitignored and should NEVER be committed

# Required: Google Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required: MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=your_mongodb_connection_string_here

# Optional: OpenRouter API Key (fallback AI API)
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: JWT Secret for authentication
# Auto-generated if not set
JWT_SECRET=your_jwt_secret_here

# Optional: Cloudflare Account ID (for deployment)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Optional: Error tracking
SENTRY_DSN=your_sentry_dsn_here

# Application URL (for production)
NEXT_PUBLIC_API_URL=https://hustlerai.tech
